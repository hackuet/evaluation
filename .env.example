# HACK Evaluation Platform Environment Variables
# Copy this file to .env and fill in your credentials.
# NOTE: .env is gitignored and will never be committed to git.

# --- YouTube Data API v3 (Unlisted Video Uploading) ---
# Path to OAuth 2.0 client secrets JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Desktop app)
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json

# Stored token path (automatically generated upon first browser authorization flow)
YOUTUBE_TOKEN_FILE=token.json

# Optional YouTube Data API v3 Key (for reading metadata/playlists)
YOUTUBE_API_KEY=

# Video Privacy Status ('unlisted', 'private', or 'public')
YOUTUBE_DEFAULT_PRIVACY=unlisted

# Video Category ID (28 = Science & Technology, 27 = Education)
YOUTUBE_CATEGORY_ID=28

# --- Google Gemini / LLM Evaluation Subagents ---
# API Key for Gemini models (used by evaluation subagents & automatic video chapter generation)
GEMINI_API_KEY=

# --- Server & Preview Settings ---
PORT=8080
HOST=127.0.0.1
